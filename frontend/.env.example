# Copy to .env.local. Vite exposes VITE_ variables to the browser,
# so never put database credentials here.
# Defaults to /api, which the dev server proxies to Flask on port 5001.
# Only set this to call a different backend directly (it must allow CORS).
# VITE_API_BASE_URL=http://localhost:5001/api

# true: use sample data in src/services/mockData.js (no backend needed).
# false: call the Flask API. Valuation shows "Unavailable" while
# POST /valuation returns 501.
VITE_USE_MOCK=true
